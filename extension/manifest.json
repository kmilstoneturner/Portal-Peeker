{
  "manifest_version": 3,
  "name": "Portal Peeker",
  "version": "1.4.0",
  "description": "Capture, inspect, and export the JSON behind HubSpot workflows and segments. No telemetry, no analytics, no third-party requests.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Portal Peeker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.hubspot.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.hubspot.com/workflows/*",
        "*://*.hubspot.com/contacts/*",
        "*://*.hubspot.com/lists/*",
        "*://*.hubspot.com/segments/*"
      ],
      "js": [
        "capture/interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.hubspot.com/workflows/*",
        "*://*.hubspot.com/contacts/*",
        "*://*.hubspot.com/lists/*",
        "*://*.hubspot.com/segments/*"
      ],
      "js": [
        "capture/bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.hubspot.com/contacts/*"
      ],
      "js": [
        "overlay/property-names.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.hubspot.com/property-settings/*",
        "*://*.hubspot.com/contacts/*"
      ],
      "js": [
        "overlay/overlay.js"
      ],
      "css": [
        "overlay/overlay.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.hubspot.com/object-builder/*"
      ],
      "js": [
        "overlay/overlay.js"
      ],
      "css": [
        "overlay/overlay.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Portal Peeker",
  "version": "1.0.0",
  "description": "Capture, inspect, and export the JSON behind HubSpot workflows. No telemetry, no analytics, no third-party requests.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Portal Peeker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [],
  "host_permissions": ["*://*.hubspot.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.hubspot.com/workflows/*"],
      "js": ["capture/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.hubspot.com/workflows/*"],
      "js": ["capture/bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}

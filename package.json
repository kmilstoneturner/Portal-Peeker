{
  "name": "portal-peeker",
  "private": true,
  "version": "1.4.0",
  "description": "Chrome extension for HubSpot admins: capture, inspect, and diff the JSON behind HubSpot workflows and segments.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "check:ai-context": "node tools/check-ai-context.mjs",
    "check:no-network": "node tools/check-no-network.mjs",
    "check:no-portal-data": "node tools/check-no-portal-data.mjs",
    "check:settings": "node tools/check-settings.mjs",
    "package": "npm run verify && node tools/package.mjs",
    "pretest": "node tools/build.mjs",
    "store-icon": "node tools/make-store-icon.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm run check:no-network && npm run check:no-portal-data && npm run check:ai-context && npm run check:settings && npm run test"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "vitest": "^4.1.10"
  }
}

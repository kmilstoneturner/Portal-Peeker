# Dependencies
node_modules/

# Build output. Generated by `npm run build`, never committed: the point of the
# no-network check is that it runs against a bundle built from the source in
# this repo, not against a bundle somebody committed by hand.
extension/dist/
*.zip

# Chrome Web Store listing assets. Generated by `npm run store-icon`, and the
# rest (screenshots, promo tile) are captured by hand and carry portal data
# until they are checked. Neither belongs in a public repo.
store-assets/

# Anything captured from a live portal. Client-portal captures are never
# committed under any circumstances; unscrubbed trial captures live here too.
# The trim tests pick these up locally and skip silently when the directory is
# empty, which is how the rules get validated at real scale without portal data
# entering a public repo.
packages/core/__fixtures__/private/

# Working notes and design docs. Kept out of the public repo deliberately: they
# are the place portal data leaks from, and they live in Notion instead.
docs/
CLAUDE.md

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Logs and secrets
*.log
npm-debug.log*
.env
.env.*
!.env.example
